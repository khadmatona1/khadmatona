# URL of the KHADMATONA Laravel API (see backend/.env's APP_URL / FRONTEND_URL)
NEXT_PUBLIC_API_URL=http://localhost

# Morocco wall-clock time for every date/time picker and display. Must match
# the backend BUSINESS_TIMEZONE. UTC = Morocco on GMT (default).
# Africa/Casablanca = IANA rule (UTC+1, GMT during Ramadan).
# NEXT_PUBLIC_BUSINESS_TIMEZONE=UTC
