APP_NAME=KHADMATONA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
SUPPORTED_LOCALES=ar,fr,en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=khadmatona
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
FRONTEND_URL=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Core Media module storage (Property galleries etc.) - see
# config/media-library.php's disk_name / config/filesystems.php's
# 'cloudinary' disk. Get these from
# https://console.cloudinary.com/app/settings/api-keys
MEDIA_DISK=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Homepage "Nos clients parlent de nous" testimonials section - real
# reviews pulled live from your Google Business Profile via the Places
# API. Get an API key (enable "Places API") at
# https://console.cloud.google.com/apis/credentials and find your Place ID
# at https://developers.google.com/maps/documentation/places/web-service/place-id
# Leave both blank to hide the section entirely (no fake data is ever shown).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# TEMPORARY - set to true to preview the testimonials section with fake
# reviews while GOOGLE_PLACES_API_KEY/GOOGLE_PLACE_ID aren't configured yet.
# Never enable this in production. Set back to false (or remove) once done -
# see config/app.php's `show_fake_reviews` key.
SHOW_FAKE_REVIEWS=false

VITE_APP_NAME="${APP_NAME}"


# WhatsApp Business via Meta's Cloud API (inbox on the dashboard, full
# conversation history stored in our database). Leave ALL of these blank to
# disable it: the dashboard then shows "WhatsApp is not configured" and
# nothing errors.
#
# Where to find each value (developers.facebook.com > your app > WhatsApp):
#   WHATSAPP_ACCESS_TOKEN       API Setup page (temporary token for testing) or
#                               a permanent System User token for production.
#   WHATSAPP_PHONE_NUMBER_ID    API Setup page - the "Phone number ID" (a long
#                               number; NOT your actual phone number).
#   WHATSAPP_BUSINESS_ACCOUNT_ID  API Setup page - only needed to list your
#                               approved message templates in the dashboard.
#   WHATSAPP_APP_SECRET         App settings > Basic > App secret. Used to
#                               verify that webhook calls really come from Meta.
#   WHATSAPP_VERIFY_TOKEN       Any random string you invent. Type the SAME
#                               string in Meta's webhook setup (below).
#
# Webhook setup: WhatsApp > Configuration > Webhook. Callback URL =
#   <public https origin>/api/v1/webhooks/whatsapp
# (Admins can copy the exact URL from GET /api/v1/whatsapp/status), Verify
# token = WHATSAPP_VERIFY_TOKEN, then subscribe to the "messages" field.
# Locally, expose the backend with a tunnel (e.g. ngrok http 80).
#
# Switching test -> production is only changing these values (no code
# change): Meta's test number/token -> your registered business number and a
# System User token; ngrok URL -> your real domain.
#
# Reminder of WhatsApp's rule: free-form replies are only allowed within 24h
# of the CUSTOMER's last message. Outside that window (or to open a new chat)
# only an approved template can be sent - the dashboard handles this for you.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Template used to start a conversation ("hello_world"/"en_US" exists on every account).
WHATSAPP_DEFAULT_TEMPLATE=hello_world
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US
# Template used to notify a saved Property Alert's contact of a new match -
# must be created and approved in Meta Business Manager separately.
WHATSAPP_ALERT_TEMPLATE=property_alert_match
# Template used to confirm a booked visit (App\Modules\Visit) - must also be
# created and approved in Meta Business Manager separately.
WHATSAPP_VISIT_CONFIRMATION_TEMPLATE=visit_confirmation
# Only used to DISPLAY the webhook URL in the dashboard; falls back to APP_URL.
WHATSAPP_WEBHOOK_BASE_URL=
# Global on/off for the AI auto-reply hook (also needs a strategy + a per-conversation flag).
WHATSAPP_AI_ENABLED=false

# Facebook Page + Instagram publishing (Meta Graph API). Create a Business app
# at developers.facebook.com, add Facebook Login, and list
# {FRONTEND_URL}/dashboard/settings/social/callback as a valid OAuth redirect.
# Accounts are then connected from Dashboard > Publication sociale; their tokens
# are stored encrypted in the database, never here.
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
META_SOCIAL_API_VERSION=v26.0
# Optional: Facebook Login for Business configuration id (replaces the scopes).
META_SOCIAL_LOGIN_CONFIG_ID=
# Optional: only if the redirect differs from the default above.
META_SOCIAL_REDIRECT_URI=

# Visitor analytics (App\Modules\Analytics, config/analytics.php)
ANALYTICS_ENABLED=true
ANALYTICS_TIMEZONE=Africa/Casablanca
ANALYTICS_RETENTION_DAYS=395
# Proxy/CDN geo headers, comma-separated, first match wins.
ANALYTICS_GEO_COUNTRY_HEADERS=CF-IPCountry,X-Country-Code
ANALYTICS_GEO_CITY_HEADERS=CF-IPCity,X-City

# Morocco wall-clock time for business rules (visit hours 9h-19h, times in
# notifications/WhatsApp, lead date filters, analytics days). UTC = Morocco on
# GMT. Africa/Casablanca = IANA rule (UTC+1, GMT during Ramadan). Keep the
# frontend NEXT_PUBLIC_BUSINESS_TIMEZONE on the same value.
BUSINESS_TIMEZONE=UTC
